NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/inseetcrm?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
FRONTEND_URL=http://localhost:5173
SETUP_KEY=replace-with-a-long-random-one-time-key
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=INSEET <noreply@example.com>

S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

MONGODB_DB_NAME=inseetcrm

# Optional Node-process DNS override for Atlas SRV resolution.
MONGODB_DNS_SERVERS=

# Enable Places API (New), billing and server-side API restrictions. Never use in VITE_ variables.
GOOGLE_PLACES_API_KEY=
